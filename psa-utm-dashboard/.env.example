# HubSpot Private App token (Settings > Integrations > Private Apps)
# Scopes necessários: crm.objects.contacts.read, crm.schemas.contacts.read
# Pode reaproveitar o mesmo token do tbs-2026-dashboard.
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Senha do dashboard (qualquer string longa). Sem ela o middleware deixa passar (modo dev).
# Em produção (Vercel), DEFINIR OBRIGATORIAMENTE — senão o dash fica aberto pra todo mundo.
DASHBOARD_PASSWORD=trocar-essa-senha
