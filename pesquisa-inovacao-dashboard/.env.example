# Copie este arquivo para .env e preencha com seus valores

# Private App Token do HubSpot
# Crie em: HubSpot > Settings > Integrations > Private Apps
# Scopes necessários: content (leitura de marketing emails)
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OPÇÃO A — IDs dos 5 e-mails (mais preciso). Separe por vírgula.
# Você acha o ID na URL do e-mail no HubSpot: /email/{portalId}/edit/{emailId}/...
EMAIL_IDS=

# OPÇÃO B — se EMAIL_IDS estiver vazio, busca por nome.
# Default: pega tudo que começa com "[PSA] Pesquisa - Inovação"
EMAIL_NAME_PREFIX=[PSA] Pesquisa - Inovação

# Porta do servidor local (default 4173)
PORT=4173

# Benchmarks para a coluna "expectativa" (em %)
BENCHMARK_OPEN_RATE=22
BENCHMARK_CLICK_RATE=2.5
