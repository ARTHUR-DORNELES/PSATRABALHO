# =====================================================================
# psa-creative-studio — variáveis de ambiente
# Copie para .env.local e preencha. Porta de dev: 3060
# =====================================================================

# ----- Supabase (projeto DEDICADO, isolado dos outros dashboards PSA) -----
# Crie um projeto novo em https://supabase.com/dashboard -> New project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Depois de rodar supabase/schema.sql, crie manualmente no dashboard do
# Supabase (Storage -> New bucket) um bucket público chamado "creative-assets".

# ----- Google Gemini (geração/edição de imagem — "nano banana") -----
# Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Só mude se o id do modelo mudar no futuro.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ----- Autenticação (senha única, pra compartilhar link externo) -----
# Sem essa variável definida, o app fica aberto (modo dev local).
DASHBOARD_PASSWORD=

# ----- Figma (botão "Abrir no Figma") -----
# URL do arquivo Figma da PSA onde as peças são montadas. Sem essa variável,
# o botão abre a lista de arquivos recentes do Figma.
NEXT_PUBLIC_FIGMA_FILE_URL=
