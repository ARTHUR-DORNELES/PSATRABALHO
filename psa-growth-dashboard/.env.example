# =====================================================================
# psa-growth-dashboard — variáveis de ambiente
# Copie para .env e preencha. Porta de dev: 3050
# =====================================================================

# ----- Modo de dados -----
# true = usa store em memória com dados de exemplo (dev sem banco).
# false = usa Supabase de verdade (exige as 3 vars abaixo).
USE_MOCK_DATA=true

# ----- Supabase (pode reusar o MESMO projeto do psa-bonus-dashboard) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Autenticação (NextAuth v5 + Google, whitelist @profissionaissa.com) -----
# Em dev local deixe AUTH_ENABLED=false para entrar sem login.
AUTH_ENABLED=false
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPERADMIN_EMAILS=crm.psa@profissionaissa.com
# Chave para bypass de auth em scripts/curl (header x-admin-key)
ADMIN_API_KEY=

# ----- HubSpot (Private App Token) -----
HUBSPOT_PRIVATE_APP_TOKEN=

# ----- IA (sugestões de melhoria) -----
ANTHROPIC_API_KEY=

# ----- Cron e Webhooks -----
# Bearer usado pela rota /api/cron/refresh e pelo GitHub Actions.
CRON_SECRET=
# Segredo que o N8N envia no header x-n8n-secret ao postar métricas de WhatsApp.
N8N_WEBHOOK_SECRET=

# ----- Mídia paga (fase 2 — opcional) -----
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
