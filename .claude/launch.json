    {
      "name": "jogo-a-voz",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const http=require('http'),fs=require('fs'),path=require('path');const root=path.join(process.cwd(),'jogo-a-voz');http.createServer((q,s)=>{let p=decodeURIComponent(q.url.split('?')[0]);if(p==='/')p='/index.html';const f=path.join(root,p);fs.readFile(f,(e,d)=>{if(e){s.writeHead(404);s.end('nf');}else{const ext=path.extname(f),t=ext==='.html'?'text/html; charset=utf-8':'text/plain';s.writeHead(200,{'content-type':t});s.end(d);}});}).listen(4399,()=>console.log('jogo-a-voz up on 4399'));"],
      "port": 4399
    },
